{
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {},
      "directTools": true
    },
    "google-dev-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${GOOGLE_DEV_KNOWLEDGE_API_KEY}"
      },
      "directTools": true
    },
    "gitlab": {
      "type": "stdio",
      "command": "glab",
      "args": [
        "mcp",
        "serve"
      ]
    }
  }
}
